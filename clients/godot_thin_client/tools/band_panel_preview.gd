			"x": DECLARE_TAME_TILE.x, "y": DECLARE_TAME_TILE.y,
			"population": 140, "ecology_phase": "thriving", "huntable": true,
			"domestication": 0.0, "husbandry_ceiling": "pastoral", "per_worker_yield": 0.12,
