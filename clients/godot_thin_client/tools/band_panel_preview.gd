		# wire carries now — a flat scalar here would leave the work rows' `+` uncapped.
		_wire_patch_rows({"x": 71, "y": 18, "per_worker_yield": 0.10}, 0.30),
		_wire_patch_rows({"x": 60, "y": 20, "per_worker_yield": 0.10}, 0.50),
