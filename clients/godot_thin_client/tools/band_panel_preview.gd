# ---- A ROW CLICK OPENS THE SOURCE'S SHEET; THE STRIP'S CHIP OPENS THE RUNG CARD (#877) -------------
#
# **DRIVEN THROUGH THE ROW'S OWN `gui_input`**, by pushing a pointer press and release through the viewport
# at the row's name — never by calling `_open_source_sheet`. `Main` is not instanced here, so the one hop it
# owns (the map's focus-and-select that `alert_focus_requested` asks for) is stood in for by a listener
# that selects what the map would have: the tile for a forage row, the herd for a hunt row.

## The press-and-release at the centre of `row`'s NAME label (the labels pass the pointer on to the row).
func _press_row_with_pointer(row: Control) -> void:
	var name_label := _row_name_label(row)
	var point := name_label.get_global_rect().get_center() if name_label != null \
		else row.get_global_rect().get_center()
	await _drive_click(_canvas_to_window(point))

## What the sheet's anchor is: the selection card's rect, which a sheet floats beside. Empty = nothing to
## float beside (the sheet would open at the canvas corner).
func _sheet_anchor_is_set() -> bool:
	return _hud._drawercompose._compose_anchor_rect().size.x > 0.0

func _render_work_row_click_states() -> void:
	_panel.set_dock(SIDE_LEFT)
	_panel.set_active_tab(&"work")
	await _stage_crew_split_board(CREW_SPLIT_MID_CREW, CREW_SPLIT_MID_KEEPERS, CREW_SPLIT_MID_KITTED)
	var band: Dictionary = _hud._band_labor.panel_band()
	var hunt_id := ""
	for assignment in (band["labor_assignments"] as Array):
		if String((assignment as Dictionary).get("kind", "")) == SourceForecast.LABOR_KIND_HUNT:
			hunt_id = String((assignment as Dictionary).get("fauna_id", ""))
			break
	var focus: Array = [Callable()]
	var listener := func(x: int, y: int) -> void:
		if (focus[0] as Callable).is_valid():
			(focus[0] as Callable).call(x, y)
	_hud.alert_focus_requested.connect(listener)

	# ---- a FORAGE row ----
	var forage_tile := BaseFx.food_tile_fixture()
	forage_tile["x"] = QUEUE_SECOND_PATCH.x
	forage_tile["y"] = QUEUE_SECOND_PATCH.y
	focus[0] = func(_x: int, _y: int) -> void: _hud.show_tile_selection(forage_tile)
	var forage_row := _sections_row(_work_row_label_for_tile(QUEUE_SECOND_PATCH))
	_assert_band_panel("row click - the forage row is on the board", forage_row != null)
	if forage_row != null:
		await _press_row_with_pointer(forage_row)
		await _settle()
		_assert_band_panel("row click - a pointer press on a forage row opens the FORAGE sheet",
			_hud._drawercompose.is_compose_sheet_open() and _hud._compose.kind() == ComposeState.KIND_FORAGE)
		_assert_band_panel("row click - …floating beside a selection card with a real rect (anchor %s)"
				% str(_hud._drawercompose._compose_anchor_rect()), _sheet_anchor_is_set())
		await _save("band_panel_row_click_forage_sheet")
		_push_bands([_crew_split_band(CREW_SPLIT_MID_CREW, CREW_SPLIT_MID_KEEPERS, CREW_SPLIT_MID_KITTED),
			_crew_split_other_band()])
		_hud.reapply_selection("tile", forage_tile)
		await _settle()
		_assert_band_panel("row click - …and the sheet is STILL open after the next snapshot refresh",
			_hud._drawercompose.is_compose_sheet_open() and _hud._compose.kind() == ComposeState.KIND_FORAGE)
		_hud._drawercompose.close_compose_sheet()
		await _settle()

	# ---- a HUNT row ----
	var herd: Dictionary = (_hud._band_labor.find_world_herd(hunt_id) as Dictionary).duplicate()
	herd["huntable"] = true
	focus[0] = func(_x: int, _y: int) -> void: _hud.show_herd_selection(herd)
	var hunt_row := _work_row_for_herd(hunt_id)
	_assert_band_panel("row click - the hunt row is on the board (%s)" % hunt_id, hunt_row != null)
	if hunt_row != null:
		await _press_row_with_pointer(hunt_row)
		await _settle()
		_assert_band_panel("row click - a pointer press on a hunt row opens the HUNT sheet",
			_hud._drawercompose.is_compose_sheet_open() and _hud._compose.kind() == ComposeState.KIND_HERD)
		_assert_band_panel("row click - …with a real anchor (%s)" % str(_hud._drawercompose._compose_anchor_rect()),
			_sheet_anchor_is_set())
		_hud.reapply_selection("herd", herd)
		await _settle()
		_assert_band_panel("row click - …and it is STILL open after the next snapshot refresh",
			_hud._drawercompose.is_compose_sheet_open() and _hud._compose.kind() == ComposeState.KIND_HERD)
		_hud._drawercompose.close_compose_sheet()
		await _settle()

	# ---- an EXTRACT (groundwork) row ----
	var work_rows := _workings_rows_drawn()
	var working_tile := {"x": ROSTER_NEAR_TILE.x, "y": ROSTER_NEAR_TILE.y,
		"visibility_state": "active", "deposits": _hud._band_labor.deposits()}
	focus[0] = func(_x: int, _y: int) -> void: _hud.show_tile_selection(working_tile)
	_assert_band_panel("row click - a groundwork row is on the board", not work_rows.is_empty())
	if not work_rows.is_empty():
		await _press_row_with_pointer(work_rows[0])
		await _settle()
		_assert_band_panel("row click - a pointer press on a groundwork row opens the WORKING sheet",
			_hud._drawercompose.is_compose_sheet_open() and _hud._compose.kind() == ComposeState.KIND_DEPOSIT)
		_assert_band_panel("row click - …with a real anchor (%s)" % str(_hud._drawercompose._compose_anchor_rect()),
			_sheet_anchor_is_set())
		_push_bands([_crew_split_band(CREW_SPLIT_MID_CREW, CREW_SPLIT_MID_KEEPERS, CREW_SPLIT_MID_KITTED),
			_crew_split_other_band()])
		await _settle()
		_assert_band_panel("row click - …and it is STILL open after the next snapshot refresh",
			_hud._drawercompose.is_compose_sheet_open() and _hud._compose.kind() == ComposeState.KIND_DEPOSIT)
		_hud._drawercompose.close_compose_sheet()
		await _settle()

	# ---- the CHIP is not the row ----
	focus[0] = func(_x: int, _y: int) -> void: _hud.show_tile_selection(forage_tile)
	var chip: Control = null
	for candidate in _collect_meta_controls(_panel, HudWorkVocab.WORK_STRIP_LADDER_META, []):
		chip = candidate
		break
	_assert_band_panel("row click - the board carries a ladder chip to press", chip != null)
	if chip != null:
		var button := _chip_button(chip)
		await _drive_click(_canvas_to_window(button.get_global_rect().get_center()))
		await _settle()
		_assert_band_panel("row click - a pointer press on the strip's chip opens the RUNG CARD",
			_hud._rungcard.is_open())
		_assert_band_panel("row click - …and does NOT open the sheet",
			not _hud._drawercompose.is_compose_sheet_open())
		await _save("band_panel_row_click_chip_rung_card")
		_hud._rungcard.dismiss()
		await _settle()
	_hud.alert_focus_requested.disconnect(listener)
	_hud.show_tile_selection({})
	_push_bands([_band_fixture()])
	_hud.update_deposits([])
	_set_forage_patches([])
	await _settle()

# ---- THE WALK HOME ROTS, AND STOOD-DOWN HANDS WALK HOME (#706) ------------------------------------
## The running posting's walk loses this much food a turn to rot — its meat keeps fewer turns than
## its 8-tile walk takes — and the row's rate is already net of it.
const SPOIL_RATE_HOME := 0.35
## The pelt posting's three hands, stood down: they walk home carrying its load, part of which rots.
const HOMEWARD_WORKERS := PARTY_PELT_WORKERS
const HOMEWARD_FOOD := 2.4
const HOMEWARD_FOOD_SPOILS := 0.8
const HOMEWARD_NEXT_LOAD_IN := 1
const HOMEWARD_ALL_HOME_IN := 3
## A FAR FORAGE row whose packs carry hay and fibre home with the food (#706). Between packs its
## `fodder_yield` / `material_yield` read nothing landed, and its row must state the HOME rates.
const FAR_FORAGE_WORKERS := 2
const FAR_FORAGE_X := 78
const FAR_FORAGE_Y := 20
const FAR_FORAGE_WALK_TILES := 7
const FAR_FORAGE_RATE_HOME := 0.3
const FAR_FORAGE_FODDER_RATE_HOME := 0.4
const FAR_FORAGE_FIBRE_RATE_HOME := 0.1
const FAR_FORAGE_FIBRE_ID := "fibre"
## The running far HUNT (Roe Deer) between packs: nothing landed this turn (`material_yield` empty),
## and its hide arrives home at this rate (#706).
const FAR_HUNT_HIDE_ID := "hide"
const FAR_HUNT_HIDE_RATE_HOME := 0.12

## The party band with its RUNNING posting's walk rotting part of its take, and its pelt posting stood
## down — those three hands now walk home (`homeward_*`), on no row and out of the idle pool, so the
## WORKFORCE bar still partitions `working_age` only if it counts them.
func _work_party_spoil_band_fixture() -> Dictionary:
	var band := _work_party_band_fixture()
	var rows: Array = []
	for row_variant in band["labor_assignments"]:
		var row: Dictionary = (row_variant as Dictionary).duplicate()
		if String(row.get("fauna_id", "")) == PARTY_PELT_HERD_ID:
			continue
		if String(row.get("fauna_id", "")) == PARTY_FAR_HERD_ID:
			row[SourceForecast.ASSIGNMENT_SPOILED_RATE_HOME_KEY] = SPOIL_RATE_HOME
			row[SourceForecast.ASSIGNMENT_MATERIAL_YIELD_KEY] = []
			row[SourceForecast.ASSIGNMENT_MATERIALS_RATE_HOME_KEY] = [{
				"material_id": FAR_HUNT_HIDE_ID, "amount": FAR_HUNT_HIDE_RATE_HOME}]
		rows.append(row)
	rows.append({
		"kind": "forage", "workers": FAR_FORAGE_WORKERS, "workers_needed": FAR_FORAGE_WORKERS,
		"floor": 0.5, "target_x": FAR_FORAGE_X, "target_y": FAR_FORAGE_Y,
		"actual_yield": FAR_FORAGE_RATE_HOME, "sustainable_yield": FAR_FORAGE_RATE_HOME,
		"realized_yield": FAR_FORAGE_RATE_HOME, "kit_id": BandFx.KIT_DEFAULT_FORAGE,
		# Between packs: nothing landed this turn.
		"fodder_yield": 0.0, "material_yield": [],
		"party_x": FAR_FORAGE_X, "party_y": FAR_FORAGE_Y, "party_workers": FAR_FORAGE_WORKERS,
		"hunters_on_the_road": 0, "walk_tiles": FAR_FORAGE_WALK_TILES, "walk_out_remaining": 0,
		"next_load_home_in": 2, "net_rate_home": FAR_FORAGE_RATE_HOME,
		SourceForecast.ASSIGNMENT_FODDER_RATE_HOME_KEY: FAR_FORAGE_FODDER_RATE_HOME,
		SourceForecast.ASSIGNMENT_MATERIALS_RATE_HOME_KEY: [{
			"material_id": FAR_FORAGE_FIBRE_ID, "amount": FAR_FORAGE_FIBRE_RATE_HOME}],
	})
	band["labor_assignments"] = rows
	# The far forage crew are working-age hands too: the bracket grows by them and so does the band.
	band["working_age"] = int(band["working_age"]) + FAR_FORAGE_WORKERS
	band["size"] = int(band["size"]) + FAR_FORAGE_WORKERS
	band["idle_workers"] = 0
	band[HudWorkVocab.HOMEWARD_WORKERS_KEY] = HOMEWARD_WORKERS
	band[HudWorkVocab.HOMEWARD_FOOD_KEY] = HOMEWARD_FOOD
	band[HudWorkVocab.HOMEWARD_FOOD_SPOILS_KEY] = HOMEWARD_FOOD_SPOILS
	band[HudWorkVocab.HOMEWARD_NEXT_LOAD_IN_KEY] = HOMEWARD_NEXT_LOAD_IN
	band[HudWorkVocab.HOMEWARD_ALL_HOME_IN_KEY] = HOMEWARD_ALL_HOME_IN
	return band

## **THE ROW SAYS WHO IS WALKING HOME FROM IT** — the per-row `homeward_*` keys. The pelt posting was
## stood down to crew 0 and its row KEPT (the sim's `keep_holding`): its three hands walk home with a
## load, free next turn — the reported case, where the row read 0 and nothing said where they went.
## The near posting keeps its party and has two more hands walking home, carrying nothing, free in
## three turns — the plural, food-less form, closing a party block.
const ROW_HOMEWARD_PELT_WORKERS := PARTY_PELT_WORKERS
const ROW_HOMEWARD_PELT_FOOD := HOMEWARD_FOOD
const ROW_HOMEWARD_PELT_ALL_HOME_IN := 1
const ROW_HOMEWARD_NEAR_WORKERS := 2
const ROW_HOMEWARD_NEAR_ALL_HOME_IN := 3

func _row_homeward_band_fixture() -> Dictionary:
	var band := _work_party_spoil_band_fixture()
	var rows: Array = band["labor_assignments"]
	for row_variant in rows:
		var row: Dictionary = row_variant
		if String(row.get("fauna_id", "")) == PARTY_NEAR_HERD_ID:
			row[HudWorkVocab.HOMEWARD_WORKERS_KEY] = ROW_HOMEWARD_NEAR_WORKERS
			row[HudWorkVocab.HOMEWARD_ALL_HOME_IN_KEY] = ROW_HOMEWARD_NEAR_ALL_HOME_IN
			row[HudWorkVocab.HOMEWARD_FOOD_KEY] = 0.0
	# The stood-down pelt row: no crew, no party, no take — only its walkers.
	rows.append({
		"kind": "hunt", "workers": 0, "fauna_id": PARTY_PELT_HERD_ID, "floor": 0.5,
		"target_x": PARTY_SOURCE_X, "target_y": PARTY_SOURCE_Y,
		"actual_yield": 0.0, "sustainable_yield": 0.0, "realized_yield": 0.0,
		"kit_id": BandFx.KIT_DEFAULT_HUNT,
		HudWorkVocab.HOMEWARD_WORKERS_KEY: ROW_HOMEWARD_PELT_WORKERS,
		HudWorkVocab.HOMEWARD_ALL_HOME_IN_KEY: ROW_HOMEWARD_PELT_ALL_HOME_IN,
		HudWorkVocab.HOMEWARD_FOOD_KEY: ROW_HOMEWARD_PELT_FOOD,
	})
	# The band's keys stay the TOTAL: the near row's two walkers join the pelt row's three.
	band[HudWorkVocab.HOMEWARD_WORKERS_KEY] = ROW_HOMEWARD_PELT_WORKERS + ROW_HOMEWARD_NEAR_WORKERS
	band["working_age"] = int(band["working_age"]) + ROW_HOMEWARD_NEAR_WORKERS
	band["size"] = int(band["size"]) + ROW_HOMEWARD_NEAR_WORKERS
	return band

## **A ROW'S OWN HANDS WALKING BACK TO IT** (`rejoining_*`) — the far hunt's source drifted back inside
## work range, so its party's walkers stay on the row and rejoin it on landing. The row's `workers`
## already holds them: Hunt keeps its crew, the band's `homeward_*` is empty, and those hands are
## neither idle nor a "Walking home" segment. The band reads the idle hands it really has.
const ROW_REJOINING_WORKERS := PARTY_PELT_WORKERS
const ROW_REJOINING_FOOD := HOMEWARD_FOOD
const ROW_REJOINING_ALL_HOME_IN := 1

func _row_rejoining_band_fixture() -> Dictionary:
	var band := _work_party_spoil_band_fixture()
	for key in [HudWorkVocab.HOMEWARD_WORKERS_KEY, HudWorkVocab.HOMEWARD_FOOD_KEY,
			HudWorkVocab.HOMEWARD_FOOD_SPOILS_KEY, HudWorkVocab.HOMEWARD_NEXT_LOAD_IN_KEY,
			HudWorkVocab.HOMEWARD_ALL_HOME_IN_KEY]:
		band.erase(key)
	for row_variant in band["labor_assignments"]:
		var row: Dictionary = row_variant
		if String(row.get("fauna_id", "")) == PARTY_FAR_HERD_ID:
			row[HudWorkVocab.REJOINING_WORKERS_KEY] = ROW_REJOINING_WORKERS
			row[HudWorkVocab.REJOINING_ALL_HOME_IN_KEY] = ROW_REJOINING_ALL_HOME_IN
			row[HudWorkVocab.REJOINING_FOOD_KEY] = ROW_REJOINING_FOOD
	return _with_wire_idle(band)

## `band_panel_work_row_rejoining`: the hunt row's walking-back line, and the band's idle count.
func _render_work_row_rejoining_state() -> void:
	_set_world_herds(_herd_fixtures())
	_push_bands([_row_rejoining_band_fixture()])
	await _pin_canvas(Vector2i(ULTRAWIDE_WIDTH, DOCKROW_CANVAS.y))
	_panel.set_dock(SIDE_BOTTOM)
	_panel.set_active_tab(&"work")
	await _settle()
	await _save("band_panel_work_row_rejoining")
	_assert_zones_within_bounds()
	_assert_zone_content_fits()
	var want := HudWorkVocab.ROW_REJOINING_LINE_FORMAT % [ROW_REJOINING_WORKERS,
		HudWorkVocab.HOMEWARD_FOOD_CLAUSE_FORMAT % SourceForecast.format_magnitude(
			ROW_REJOINING_FOOD), HudWorkVocab.ROW_REJOINING_HERE_NEXT_TURN]
	var lines := _work_party_lines(_work_row_for_herd(PARTY_FAR_HERD_ID))
	_assert_band_panel("band_panel_work_row_rejoining: the hunt row says its hands are walking back - want [%s], got %s"
			% [want, str(lines)], lines.has(want))
	var band: Dictionary = _hud._band_labor._panel_band
	_assert_band_panel("...and those hands are in the row, so the band's idle is the %d it really has (got %d)"
			% [ROW_REJOINING_WORKERS, _hud._band_labor.effective_idle(band)],
		_hud._band_labor.effective_idle(band) == ROW_REJOINING_WORKERS)

## `band_panel_work_row_homeward`: each row's walker line, in the quiet ink, under the right row.
func _render_work_row_homeward_state() -> void:
	_set_world_herds(_herd_fixtures() + [{"id": PARTY_PELT_HERD_ID, "species": "Grey Wolf",
		"x": 75, "y": 17, "population": 24, "ecology_phase": "thriving"}])
	_push_bands([_row_homeward_band_fixture()])
	await _pin_canvas(Vector2i(ULTRAWIDE_WIDTH, DOCKROW_CANVAS.y))
	_panel.set_dock(SIDE_BOTTOM)
	_panel.set_active_tab(&"work")
	await _settle()
	await _save("band_panel_work_row_homeward")
	_assert_zones_within_bounds()
	_assert_zone_content_fits()
	var pelt_row := _work_row_for_herd(PARTY_PELT_HERD_ID)
	var pelt := _work_party_lines(pelt_row)
	var want_pelt := HudWorkVocab.ROW_HOMEWARD_LINE_FORMAT % [ROW_HOMEWARD_PELT_WORKERS,
		HudWorkVocab.HOMEWARD_FOOD_CLAUSE_FORMAT % SourceForecast.format_magnitude(
			ROW_HOMEWARD_PELT_FOOD), HudWorkVocab.ROW_HOMEWARD_FREE_NEXT_TURN]
	_assert_band_panel("band_panel_work_row_homeward: a crew-0 row with hands walking home stays on the board and says so — want [%s], got %s"
			% [want_pelt, str(pelt)], pelt_row != null and pelt == [want_pelt])
	var ink_ok := false
	if pelt_row != null:
		for control in _collect_meta_controls(pelt_row, HudWorkVocab.WORK_ROW_PARTY_META, []):
			ink_ok = (control as Label).get_theme_color(FONT_COLOR_THEME_KEY) \
				.is_equal_approx(HudStyle.INK_DIM)
	_assert_band_panel("…in the Workforce zone's quiet ink", ink_ok)
	var near := _work_party_lines(_work_row_for_herd(PARTY_NEAR_HERD_ID))
	var want_near := HudWorkVocab.ROW_HOMEWARD_LINE_FORMAT % [ROW_HOMEWARD_NEAR_WORKERS, "",
		HudWorkVocab.ROW_HOMEWARD_FREE_IN_FORMAT % ROW_HOMEWARD_NEAR_ALL_HOME_IN]
	_assert_band_panel("…and closes a posted row's party block, food-less and plural — want %s last, got %s"
			% [want_near, str(near)], near.size() > 1 and near[near.size() - 1] == want_near)
	# The format leads with its count, so the needle is its words up to the food clause.
	var far := _work_party_lines(_work_row_for_herd(PARTY_FAR_HERD_ID))
	_assert_band_panel("…while a row nobody walks home from grows no walker line (%s)" % str(far),
		not far.any(func(line: String) -> bool: return line.contains(
			HudWorkVocab.ROW_HOMEWARD_LINE_FORMAT.get_slice("%s", 0).trim_prefix("%d"))))

## **THE TWO #706 READOUTS ON THE BAND PANEL**: the work row's amber spoil line under its party block
## (`band_panel_work_party_spoils`), and the WORKFORCE zone's walking-home lines over a bar that counts
## those hands (`band_panel_homeward`).
func _render_work_party_spoil_states() -> void:
	_set_forage_patches([])
	_set_world_herds(_herd_fixtures())
	_push_bands([_work_party_spoil_band_fixture()])
	await _pin_canvas(Vector2i(ULTRAWIDE_WIDTH, DOCKROW_CANVAS.y))
	_panel.set_dock(SIDE_BOTTOM)
	_panel.set_active_tab(&"work")
	await _settle()
	await _save("band_panel_work_party_spoils")
	_assert_zones_within_bounds()
	_assert_zone_content_fits()
	var far_row := _work_row_for_herd(PARTY_FAR_HERD_ID)
	var far := _work_party_lines(far_row)
	var want_spoil := HudWorkVocab.WORK_ROW_PARTY_SPOILS_LEAD \
		+ HudWorkVocab.ROT_RATE_FORMAT % SourceForecast.format_magnitude(SPOIL_RATE_HOME)
	_assert_band_panel("band_panel_work_party_spoils: a far row whose walk rots states the loss last (%s)"
			% str(far),
		far.size() == 3 and far[2] == want_spoil)
	var spoil_ink_ok := false
	if far_row != null:
		for control in _collect_meta_controls(far_row, HudWorkVocab.WORK_ROW_PARTY_META, []):
			if String(control.get_meta(HudWorkVocab.WORK_ROW_PARTY_META)) == want_spoil:
				spoil_ink_ok = (control as Label).get_theme_color(FONT_COLOR_THEME_KEY) \
					.is_equal_approx(HudStyle.WARN)
	_assert_band_panel("…in the Spoiled row's amber", spoil_ink_ok)
	# **A FAR FORAGE ROW STATES ITS HOME-ARRIVING HAY AND FIBRE** (#706), not the nothing that landed
	# between packs.
	var forage_accounts := _work_row_accounts_text(_work_row_labelled(
		HudWorkVocab.WORK_ROW_PLANT_FORMAT % [FAR_FORAGE_X, FAR_FORAGE_Y]))
	var want_forage := SourceForecast.yield_components(FAR_FORAGE_RATE_HOME,
		FAR_FORAGE_FODDER_RATE_HOME, SourceForecast.YIELD_ACCOUNT_FOOD,
		[{"material_id": FAR_FORAGE_FIBRE_ID, "amount": FAR_FORAGE_FIBRE_RATE_HOME}])
	_assert_band_panel("a far forage row prints its HOME fodder and fibre rates — want %s, got %s"
			% [want_forage, forage_accounts],
		forage_accounts.contains(want_forage))
	# **AND A FAR HUNT ROW STATES ITS HOME-ARRIVING HIDE** between packs.
	var hunt_accounts := _work_row_accounts_text(far_row)
	var want_hunt := SourceForecast.yield_components(PARTY_FAR_RATE, 0.0,
		SourceForecast.YIELD_ACCOUNT_FOOD,
		[{"material_id": FAR_HUNT_HIDE_ID, "amount": FAR_HUNT_HIDE_RATE_HOME}])
	_assert_band_panel("a far hunt row prints its HOME hide rate — want %s, got %s"
			% [want_hunt, hunt_accounts],
		hunt_accounts.contains(want_hunt))
	var near := _work_party_lines(_work_row_for_herd(PARTY_NEAR_HERD_ID))
	_assert_band_panel("…while a posting whose walk rots nothing grows no spoil line (%s)" % str(near),
		near.size() == 2 and not HudWorkVocab.is_party_spoils_line(near[near.size() - 1]))

	await _pin_canvas(PREVIEW_SIZE)
	_panel.set_dock(SIDE_LEFT)
	_panel.set_active_tab(&"band")
	await _settle()
	await _save("band_panel_homeward")
	_assert_zones_within_bounds()
	_assert_zone_content_fits()
	_assert_people_bar_is_one_bar("band_panel_homeward")
	var band: Dictionary = _hud._band_labor._panel_band
	_assert_band_panel("band_panel_homeward: hands walking home are NOT idle (idle %d)"
			% _hud._band_labor.effective_idle(band),
		_hud._band_labor.effective_idle(band) == 0)
	var band_zone: Node = _panel._zones.get(BandCityPanel.ZONE_BAND)
	var tip := _composition_chip_tooltip(band_zone, HudWorkVocab.ZONE_HEADER_PEOPLE,
		HudWorkVocab.PEOPLE_GLYPH_WORKING)
	_assert_band_panel("...the working tooltip counts them as their own part (`%s`)" % tip,
		tip.contains(HudWorkVocab.PEOPLE_WORKING_PART_FORMAT % [
			HudWorkVocab.WORKING_PART_HOMEWARD, HOMEWARD_WORKERS]))
	var drawn: Array[String] = []
	for control in _collect_meta_controls(band_zone, HudWorkVocab.HOMEWARD_LINE_META, []):
		drawn.append(String(control.get_meta(HudWorkVocab.HOMEWARD_LINE_META)))
	var want_lines: Array[String] = [
		HudWorkVocab.HOMEWARD_LINE_FORMAT % [HOMEWARD_WORKERS,
			HudWorkVocab.HOMEWARD_FOOD_CLAUSE_FORMAT % SourceForecast.format_magnitude(HOMEWARD_FOOD),
			HudWorkVocab.HOMEWARD_TURNS_FORMAT % HOMEWARD_ALL_HOME_IN],
		HudWorkVocab.HOMEWARD_FIRST_LOAD_FORMAT % HudWorkVocab.HOMEWARD_TURNS_ONE,
		HudWorkVocab.HOMEWARD_SPOILS_FORMAT % SourceForecast.format_magnitude(HOMEWARD_FOOD_SPOILS),
	]
	_assert_band_panel("…and the WORKFORCE zone says who walks home, with what, and what will spoil — want %s, got %s"
			% [str(want_lines), str(drawn)], drawn == want_lines)

	# Each ROW's own walkers (the per-row `homeward_*` keys) — before the hand-back, so no later
	# frame moves.
	await _render_work_row_homeward_state()
	await _render_work_row_rejoining_state()

	# Hand the world and the reference band back.
	_set_forage_patches([])
	_set_world_herds(_herd_fixtures())
	_push_bands([_band_fixture()])
	_panel.set_dock(SIDE_LEFT)
	await _settle()

# ---- ANOTHER PEOPLE'S BUILD ON A WORK ROW --------------------------------------------------------------

const OTHER_PEOPLE_FACTION := 1
const OTHER_PEOPLE_NAME := "Lothari"
const OTHER_BUILD_METER := 0.2
## What the row's second line leads with when the meter is another people's, as the player reads it.
const OTHER_TAME_METER := 0.3
const OTHER_BUILDER_ENTITY := 777
const OTHER_BUILDER_NAME := "Netherford"
const OTHER_BUILDER_POS := Vector2i(70, 5)
const OTHER_TAME_LINE := "Lothari taming \u00b7 30%"
const OTHER_BUILD_LINE := "Lothari cultivating \u00b7 20%"

## The wild tile of the rung board, carrying a 20% Cultivate meter owned by `owner_faction`.
func _other_build_patches(owner_faction: int) -> Array:
	var patches := _rung_patch_fixtures()
	var wild: Dictionary = patches[0]
	wild["cultivation_progress"] = OTHER_BUILD_METER
	wild["has_owner"] = true
	wild["owner"] = owner_faction
	return RUNG_FX.stamp_patches([wild])

func _wild_row_foreign_text() -> String:
	for control in _collect_meta_controls(_panel, HudWorkVocab.WORK_ROW_FOREIGN_BUILD_META, []):
		return String(control.get_meta(HudWorkVocab.WORK_ROW_FOREIGN_BUILD_META))
	return ""

func _wild_row_model() -> Dictionary:
	for model in _hud._bandpanel._work_source_models(_hud._band_labor._panel_band):
		if String(model.get("key", "")) == "forage:%d,%d" % [RUNG_WILD_TILE.x, RUNG_WILD_TILE.y]:
			return model
	return {}

func _other_peoples_build_rows() -> void:
	FactionNames.update([{"faction": OTHER_PEOPLE_FACTION, "name": OTHER_PEOPLE_NAME}])
	_hud.update_food_modules(_rung_forage_modules())
	_set_world_herds(_rung_herd_fixtures())
	_push_bands([_rung_band_fixture()])
	_panel.set_dock(SIDE_LEFT)
	_panel.set_active_tab(&"work")
	# THEIRS: the row names the people and carries no ready or building face of ours.
	var patches := _rung_patch_fixtures()
	patches[0] = _other_build_patches(OTHER_PEOPLE_FACTION)[0]
	_set_forage_patches(patches)
	_push_bands([_rung_band_fixture()])
	await _settle()
	await _save("band_panel_work_other_build")
	var theirs := _wild_row_model()
	if String(theirs.get("foreign_build", "")) != OTHER_BUILD_LINE:
		_fail("work row, another people's build: wanted `%s`, got `%s`" % [OTHER_BUILD_LINE, theirs.get("foreign_build", "")])
	if String(theirs.get("building_glyph", "")) != "" or String(theirs.get("ready_glyph", "")) != "":
		_fail("work row, another people's build: the row still wears OUR build or offer face")
	if _wild_row_foreign_text() != OTHER_BUILD_LINE:
		_fail("work row, another people's build: the rendered line two does not lead with `%s`" % OTHER_BUILD_LINE)
	if _find_meta_control(_panel, HudWorkVocab.WORK_ROW_FOREIGN_BAND_META) != null:
		_fail("work row, no builder named: a band link was drawn with nothing to jump to")
	# A NAMED BUILDER: the band's name only, as a link that focuses its tile.
	patches = _rung_patch_fixtures()
	patches[0] = _other_build_patches(OTHER_PEOPLE_FACTION)[0]
	patches[0]["builder_band"] = OTHER_BUILDER_ENTITY + FIXTURE_BAND_ID_OFFSET
	_set_forage_patches(patches)
	# The builder is a foreign band in sight, so it rides the roster push like any other cohort.
	_push_bands([_rung_band_fixture(), {"entity": OTHER_BUILDER_ENTITY, "name": OTHER_BUILDER_NAME,
		"faction": OTHER_PEOPLE_FACTION, "current_x": OTHER_BUILDER_POS.x,
		"current_y": OTHER_BUILDER_POS.y, "size": 22}])
	await _settle()
	await _save("band_panel_work_other_builder")
	var named_line := "%s cultivating \u00b7 20%%" % OTHER_BUILDER_NAME
	if _wild_row_foreign_text() != named_line:
		_fail("work row, named builder: wanted `%s`, got `%s`" % [named_line, _wild_row_foreign_text()])
	var link := _find_meta_control(_panel, HudWorkVocab.WORK_ROW_FOREIGN_BAND_META)
	if link == null or not (link is Button) or (link as Button).text != OTHER_BUILDER_NAME:
		_fail("work row, named builder: no `%s` link" % OTHER_BUILDER_NAME)
	else:
		var focused: Array = []
		_hud._bandpanel.alert_focus_requested.connect(func(x: int, y: int) -> void: focused.append(Vector2i(x, y)))
		(link as Button).pressed.emit()
		if focused != [OTHER_BUILDER_POS]:
			_fail("work row, builder link: pressing it focused %s, wanted [%s]" % [str(focused), str(OTHER_BUILDER_POS)])
	_push_bands([_rung_band_fixture()])
	# OURS: the same patch owned by us reads unchanged -- the control.
	patches = _rung_patch_fixtures()
	patches[0] = _other_build_patches(HudConst.PLAYER_FACTION_ID)[0]
	_set_forage_patches(patches)
	_push_bands([_rung_band_fixture()])
	await _settle()
	await _save("band_panel_work_own_build")
	var ours := _wild_row_model()
	if String(ours.get("foreign_build", "")) != "":
		_fail("work row, our own build: carries a foreign line `%s`" % ours.get("foreign_build", ""))
	if String(ours.get("building_glyph", "")) == "":
		_fail("work row, our own build: lost its own build face")
	if _wild_row_foreign_text() != "":
		_fail("work row, our own build: rendered a foreign line")
	_set_forage_patches(_rung_patch_fixtures())
	# THE HERD SIDE: the pastoral herd 30% through the Tame, Lothari's and then ours.
	for owner in [OTHER_PEOPLE_FACTION, HudConst.PLAYER_FACTION_ID]:
		var herds := _rung_herd_fixtures()
		var boar: Dictionary = herds[0]
		boar["domestication"] = OTHER_TAME_METER
		boar["has_owner"] = true
		boar["owner"] = owner
		RUNG_FX.stamp_herd(boar)
		_set_world_herds(herds)
		_push_bands([_rung_band_fixture()])
		await _settle()
		var frame := "band_panel_work_other_tame" if owner == OTHER_PEOPLE_FACTION else "band_panel_work_own_tame"
		await _save(frame)
		var model := {}
		for candidate in _hud._bandpanel._work_source_models(_hud._band_labor._panel_band):
			if String(candidate.get("key", "")) == "hunt:%s" % RUNG_PASTORAL_HERD_ID:
				model = candidate
		if owner == OTHER_PEOPLE_FACTION:
			if String(model.get("foreign_build", "")) != OTHER_TAME_LINE:
				_fail("work row, another people's Tame: wanted `%s`, got `%s`" % [OTHER_TAME_LINE, model.get("foreign_build", "")])
			if String(model.get("building_glyph", "")) != "" or String(model.get("ready_glyph", "")) != "":
				_fail("work row, another people's Tame: still wears OUR build or offer face")
			if _wild_row_foreign_text() != OTHER_TAME_LINE:
				_fail("work row, another people's Tame: the rendered line two does not lead with `%s`" % OTHER_TAME_LINE)
		else:
			if String(model.get("foreign_build", "")) != "" or String(model.get("building_glyph", "")) == "":
				_fail("work row, our own Tame: changed (foreign `%s`, face `%s`)" % [model.get("foreign_build", ""), model.get("building_glyph", "")])
			if _wild_row_foreign_text() != "":
				_fail("work row, our own Tame: rendered a foreign line")
	_set_world_herds(_rung_herd_fixtures())
	FactionNames.reset()



# ---- THE CHIP'S BORDER AND ITS HOVER READ ONE PHASE (`WorkStrip.build_phase`) ----------------------------

## The two declared forage builds the phase states stage, the staffed one first.
const PHASE_STAFFED_PATCH := Vector2i(71, 18)
const PHASE_EMPTY_PATCH := Vector2i(72, 18)
## The builders the sim staffed on the staffed site, and the most its build could take.
const PHASE_SITE_BUILDERS := 2
const PHASE_SITE_BUILDERS_CAP := 3
## The declared working the groundwork states stage.
const PHASE_WORKING_TILE := Vector2i(70, 17)

## **A BUILD IS WORKED BY ITS OWN SITE'S CREW, SO THERE ARE TWO PHASES.** Two declared forage builds under the
## same band: the one with builders on its site (`builders_staffed` > 0) is `building` - no amber, `N building
## (up to M)` - and the one with nobody on its site is `stalled` - amber, and the sentence that every worker
## is busy on a work row. Then the same pair on a declared working. Both read `WorkStrip.build_phase`, so
## the border and the hover cannot disagree.
func _render_build_phase_states() -> void:
	_panel.set_dock(SIDE_LEFT)
	_panel.set_active_tab(&"work")
	_hud.update_intensification([_standing_knowledge_row()])
	var patches: Array = []
	for tile in [PHASE_STAFFED_PATCH, PHASE_EMPTY_PATCH]:
		var patch: Dictionary = (_track_climbing_patch_fixtures()[0] as Dictionary).duplicate(true)
		patch["x"] = (tile as Vector2i).x
		patch["y"] = (tile as Vector2i).y
		patch["builders_staffed"] = PHASE_SITE_BUILDERS if tile == PHASE_STAFFED_PATCH else 0
		patch["builders_cap"] = PHASE_SITE_BUILDERS_CAP
		patches.append(patch)
	_set_forage_patches(patches)
	_set_world_herds([])
	var band := _band_fixture()
	band["idle_workers"] = 0
	var rows: Array = []
	for tile in [PHASE_STAFFED_PATCH, PHASE_EMPTY_PATCH]:
		rows.append({"kind": SourceForecast.LABOR_KIND_FORAGE, "workers": 3, "workers_needed": 3,
			"floor": 0.5, "target_x": (tile as Vector2i).x, "target_y": (tile as Vector2i).y,
			"fauna_id": "", "improvement": SourceForecast.IMPROVEMENT_SOW,
			"actual_yield": 0.48, "sustainable_yield": 0.48})
	band["labor_assignments"] = rows
	_push_bands([band])
	await _settle()
	await _save("band_panel_build_phase_building")
	var building: Array = []
	for chip in _collect_meta_controls(_panel, HudWorkVocab.WORK_STRIP_LADDER_META, []):
		if String(chip.get_meta(HudWorkVocab.WORK_STRIP_LADDER_META)) in [
				WorkStrip.LADDER_BUILDING, WorkStrip.LADDER_STALLED]:
			building.append(chip)
	_assert_band_panel("build phase - two declared forage builds draw two chips (got %d)" % building.size(),
		building.size() == 2)
	if building.size() == 2:
		var staffed: Control = null
		var empty: Control = null
		for chip in building:
			var model: Dictionary = (chip as Control).get_meta(HudWorkVocab.WORK_ROW_MODEL_META, {})
			if int(model.get("x", -1)) == PHASE_STAFFED_PATCH.x:
				staffed = chip
			else:
				empty = chip
		_assert_band_panel("build phase - the site with builders is building, not amber, and states its crew (kind `%s`, tip \"%s\")"
				% [staffed.get_meta(HudWorkVocab.WORK_STRIP_LADDER_META), staffed.tooltip_text],
			String(staffed.get_meta(HudWorkVocab.WORK_STRIP_LADDER_META)) == WorkStrip.LADDER_BUILDING
				and staffed.tooltip_text.contains(HudWorkVocab.BUILD_CREW_STAFFED_FORMAT
					% [PHASE_SITE_BUILDERS, PHASE_SITE_BUILDERS_CAP])
				and not staffed.tooltip_text.contains(HudWorkVocab.BUILD_CREW_NO_HANDS))
		_assert_band_panel("build phase - the site with nobody on it is amber and says every worker is busy (kind `%s`, tip \"%s\")"
				% [empty.get_meta(HudWorkVocab.WORK_STRIP_LADDER_META), empty.tooltip_text],
			String(empty.get_meta(HudWorkVocab.WORK_STRIP_LADDER_META)) == WorkStrip.LADDER_STALLED
				and empty.tooltip_text.contains(HudWorkVocab.BUILD_CREW_NO_HANDS))

	# A FORAGE build with nobody on its site and its keeping covered (`BUILD_METER_HOLDS`) is stalled too: the
	# rule is "no builder staffed on this site", not the producer's verdict alone.
	var parked_patch: Dictionary = (_build_state_patches()[3] as Dictionary).duplicate(true)
	parked_patch["builders_staffed"] = 0
	_set_forage_patches([parked_patch])
	var parked_band := _band_fixture()
	parked_band["idle_workers"] = 0
	parked_band["labor_assignments"] = [{"kind": SourceForecast.LABOR_KIND_FORAGE, "workers": 3,
		"workers_needed": 3, "floor": 0.5, "target_x": BUILD_STATE_PARKED_TILE.x,
		"target_y": BUILD_STATE_PARKED_TILE.y, "fauna_id": "",
		"improvement": SourceForecast.IMPROVEMENT_CULTIVATE, "actual_yield": 0.2, "sustainable_yield": 0.2}]
	_push_bands([parked_band])
	await _settle()
	var parked_chip: Control = null
	for chip in _collect_meta_controls(_panel, HudWorkVocab.WORK_STRIP_LADDER_META, []):
		if String(chip.get_meta(HudWorkVocab.WORK_STRIP_LADDER_META)) in [
				WorkStrip.LADDER_BUILDING, WorkStrip.LADDER_STALLED]:
			parked_chip = chip
	_assert_band_panel("build phase - a forage build with nobody on its site and its keeping covered draws a build chip",
		parked_chip != null)
	if parked_chip != null:
		_assert_band_panel("build phase - ...amber (kind `%s`) and the nobody-is-building sentence (\"%s\")"
				% [parked_chip.get_meta(HudWorkVocab.WORK_STRIP_LADDER_META), parked_chip.tooltip_text],
			String(parked_chip.get_meta(HudWorkVocab.WORK_STRIP_LADDER_META)) == WorkStrip.LADDER_STALLED
				and parked_chip.tooltip_text.contains(HudWorkVocab.BUILD_CREW_NO_HANDS))

	# A declared WORKING with nobody on its site: the deposit web reads its own row's `builders_staffed`.
	_set_forage_patches([])
	var working := _workings_row(PHASE_WORKING_TILE, WORKINGS_STONE, false, WORKINGS_STONE_TAKE)
	working["is_queued"] = true
	working["build_fraction"] = 0.4
	working["builders_staffed"] = 0
	working["builders_cap"] = PHASE_SITE_BUILDERS_CAP
	_hud.update_deposit_rungs(_deposit_rung_catalog())
	_hud.update_deposits([working])
	var empty_band := _band_fixture()
	empty_band["idle_workers"] = 0
	empty_band["labor_assignments"] = [{"kind": HudConst.LABOR_KIND_EXTRACT, "workers": 2,
		"target_x": PHASE_WORKING_TILE.x, "target_y": PHASE_WORKING_TILE.y, "fauna_id": "",
		"material": WORKINGS_STONE, "actual_yield": 0.0, "sustainable_yield": 0.0}]
	_push_bands([empty_band])
	await _settle()
	await _save("band_panel_build_phase_stalled")
	var stalled: Control = null
	for chip in _collect_meta_controls(_panel, HudWorkVocab.WORK_STRIP_LADDER_META, []):
		if String(chip.get_meta(HudWorkVocab.WORK_STRIP_LADDER_META)) in [
				WorkStrip.LADDER_BUILDING, WorkStrip.LADDER_STALLED]:
			stalled = chip
	_assert_band_panel("build phase - a declared working with nobody on its site draws a build chip",
		stalled != null)
	if stalled != null:
		_assert_band_panel("build phase - ...amber (kind `%s`) and the nobody-is-building sentence (\"%s\")"
				% [stalled.get_meta(HudWorkVocab.WORK_STRIP_LADDER_META), stalled.tooltip_text],
			String(stalled.get_meta(HudWorkVocab.WORK_STRIP_LADDER_META)) == WorkStrip.LADDER_STALLED
				and stalled.tooltip_text.contains(HudWorkVocab.BUILD_CREW_NO_HANDS))
	# ...and the same working with builders staffed on it is building.
	working["builders_staffed"] = PHASE_SITE_BUILDERS
	_hud.update_deposits([working])
	_push_bands([empty_band])
	await _settle()
	var working_chip: Control = null
	for chip in _collect_meta_controls(_panel, HudWorkVocab.WORK_STRIP_LADDER_META, []):
		if String(chip.get_meta(HudWorkVocab.WORK_STRIP_LADDER_META)) in [
				WorkStrip.LADDER_BUILDING, WorkStrip.LADDER_STALLED]:
			working_chip = chip
	_assert_band_panel("build phase - a declared working with builders staffed on its site is building (kind `%s`)"
			% ("<no chip>" if working_chip == null else working_chip.get_meta(HudWorkVocab.WORK_STRIP_LADDER_META)),
		working_chip != null
			and String(working_chip.get_meta(HudWorkVocab.WORK_STRIP_LADDER_META)) == WorkStrip.LADDER_BUILDING
			and working_chip.tooltip_text.contains(HudWorkVocab.BUILD_CREW_STAFFED_FORMAT
				% [PHASE_SITE_BUILDERS, PHASE_SITE_BUILDERS_CAP]))
	_hud.update_deposits([])
	_set_forage_patches([])
	_set_world_herds(_herd_fixtures())
	_push_bands([_band_fixture()])
	await _settle()
