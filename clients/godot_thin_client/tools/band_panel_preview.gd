		_assert_band_panel("crew bar, big crew - the squares shrank no smaller than their floor (%.1f)"
				% float(plan["size"]), float(plan["size"]) >= HudWorkVocab.CREW_SPLIT_MARK_SIZE_FLOOR - 0.001)
