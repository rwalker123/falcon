; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ShadowScale Godot Thin Client"
config/description="Spike client rendering tactical map overlays for Shadow-Scale"
run/main_scene="res://src/ui/LandingScreen.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.043, 0.067, 0.078, 1)

[autoload]

TerrainTextureManager="*res://assets/terrain/TerrainTextureManager.gd"
GameLaunch="*res://src/scripts/GameLaunch.gd"
ClientSettings="*res://src/scripts/ClientSettings.gd"
UiScaler="*res://src/scripts/ui_scaler.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gd_project]

config_version=5

[rendering]

quality/driver/driver_name="opengl3"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.043, 0.067, 0.078, 1)
